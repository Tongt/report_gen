# 复制为 secrets.toml 仅用于本地开发测试（勿提交 secrets.toml）。
#
# DashScope API Key 请在应用页面由每位使用者自行填写，不要写在这里。

# 多访客磁盘隔离（Cloud 上若未自动识别，请设为 true）
# WUKAN_MULTI_TENANT = "true"

# 强制恢复「全员共用同一 knowledge_base / user_settings」旧行为（仅私有单团队）
# WUKAN_SINGLE_TENANT = "true"
#
# 可选模型仅能通过项目根目录 .env 配置（QWEN_CHAT_MODEL / QWEN_EMBEDDING_MODEL），
# 当前版本不会从 Streamlit Secrets 读取模型名。
# QWEN_CHAT_MODEL = "qwen-max"
# QWEN_EMBEDDING_MODEL = "text-embedding-v4"
